#include <iostream>
using namespace std;

int main()
{
    int a, b, c;

    cout << "Введіть три цілих числа: ";
    cin >> a >> b >> c;

    cout << "Початкові значення: a = " << a << ", b = " << b << ", c = " << c << endl;

    int sum = a + b + c;
    cout << "Сума чисел = " << sum << endl;

    if (a > b) { int t = a; a = b; b = t; }
    if (b > c) { int t = b; b = c; c = t; }
    if (a > b) { int t = a; a = b; b = t; }

    if (sum < 50)
    {
        cout << "Сума < 50, порядок зростання: "
             << a << " " << b << " " << c << endl;
    }
    else
    {
        cout << "Сума >= 50, порядок спадання: "
             << c << " " << b << " " << a << endl;
    }

    return 0;
}
