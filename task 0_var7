// Лабораторна робота №3. Завдання 0, варіант 7

#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int a = 12, b = 7;      
    int n = 42;             
    int currentYear = 2026;  
    char ch = 'k';           
    double x = 3;          

    if (a > b) cout << "1. Більше: " << a << endl;
    else       cout << "1. Більше: " << b << endl;

    int mn;
    if (a < b) mn = a;
    else       mn = b;
    cout << "2. Менше: " << mn << endl;

    if (n % 2 == 0) cout << "3. Число парне" << endl;
    else            cout << "3. Число непарне" << endl;

    
    if (n % 7 == 0) cout << "4. Кратне 7" << endl;
    else            cout << "4. Не кратне 7" << endl;

    if (n < currentYear) cout << "5. Менше від поточного року" << endl;
    else                 cout << "5. Не менше від поточного року" << endl;

   
    if (abs(n) >= 10 && abs(n) <= 99) cout << "6. Двозначне" << endl;
    else                              cout << "6. Не двозначне" << endl;

    if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z'))
        cout << "7. Латинська літера" << endl;
    else
        cout << "7. Не латинська літера" << endl;

  
    if (x * x + 5 * x - 6 > 0) cout << "8. Є розв'язком" << endl;
    else                       cout << "8. Не є розв'язком" << endl;

    if (x <= -10 || (x >= 5 && x <= 100) || x > 1000)
        cout << "9. Належить" << endl;
    else
        cout << "9. Не належить" << endl;

    if (x > -100 && x <= 10) cout << "10. Належить" << endl;
    else                     cout << "10. Не належить" << endl;

    return 0;
}
